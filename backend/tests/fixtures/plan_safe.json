        {
          "address": "aws_iam_policy.ci_deploy",
          "type": "aws_iam_policy",
          "name": "ci_deploy",
          "values": {
            "name": "CiDeployPolicy",
            "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\"],\"Resource\":\"arn:aws:s3:::ci-artifacts-bucket/*\"}]}"
          }
        },
        {
          "address": "aws_iam_user_policy_attachment.ci_deploy",
          "type": "aws_iam_user_policy_attachment",
          "name": "ci_deploy",
          "values": {
            "user": "ci-deployer",
            "policy_arn": "arn:aws:iam::111111111111:policy/CiDeployPolicy"
          }
        },
        {
          "address": "aws_security_group.internal",
          "type": "aws_security_group",
