{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_s3_bucket.artifacts",
          "type": "aws_s3_bucket",
          "name": "artifacts",
          "values": { "bucket": "ci-artifacts-bucket" }
        },
        {
          "address": "aws_s3_bucket_public_access_block.artifacts",
          "type": "aws_s3_bucket_public_access_block",
          "name": "artifacts",
          "values": {
            "bucket": "ci-artifacts-bucket",
            "block_public_acls": true,
            "block_public_policy": true,
            "ignore_public_acls": true,
            "restrict_public_buckets": true
          }
        },
        {
          "address": "aws_s3_bucket_server_side_encryption_configuration.artifacts",
          "type": "aws_s3_bucket_server_side_encryption_configuration",
          "name": "artifacts",
          "values": { "bucket": "ci-artifacts-bucket" }
        },
        {
          "address": "aws_s3_bucket_versioning.artifacts",
          "type": "aws_s3_bucket_versioning",
          "name": "artifacts",
          "values": {
            "bucket": "ci-artifacts-bucket",
            "versioning_configuration": [{ "status": "Enabled" }]
          }
        },
        {
          "address": "aws_s3_object.deploy_credentials",
          "type": "aws_s3_object",
          "name": "deploy_credentials",
          "values": { "bucket": "ci-artifacts-bucket", "key": "ci/credentials.csv" }
        },
        {
          "address": "aws_iam_user.ci_deployer",
