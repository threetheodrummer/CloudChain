# Copy to .env and fill in for --mode real (uses your normal AWS credential
# chain -- these vars are optional overrides, not required if you already
# have `aws configure` set up or an instance role attached).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CloudChain-specific settings (all optional, shown with defaults)
CLOUDCHAIN_MODE=demo
CLOUDCHAIN_DB_PATH=./data/cloudchain.db
CLOUDCHAIN_STALE_KEY_DAYS=90
CLOUDCHAIN_MIN_PW_LEN=14
